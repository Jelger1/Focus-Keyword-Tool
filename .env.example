# Kopieer dit bestand naar .env.local voor lokaal draaien,
# en zet dezelfde variabelen in Vercel onder Settings -> Environment Variables.

# Verplicht. De intent check, de herfocus en de content gap lopen via Claude.
# Aanmaken op https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Verplicht. De Google-top 10 met paginatypes, zoekvolumes, keyword-ideeën en
# de zoekwoorden waarop een URL rankt. Aanmaken in Ahrefs onder Account -> API.
AHREFS_API_KEY=

# Optioneel. 'ahrefs' (standaard zodra AHREFS_API_KEY gezet is) of 'serper'.
# Serper geeft de live top 10 zonder paginatypes en topzoekwoorden.
SERP_PROVIDER=

# Alleen nodig als SERP_PROVIDER=serper. Aanmaken op https://serper.dev
SERPER_API_KEY=

# Optioneel. Laat leeg of weg = de tool is open voor iedereen met de link.
# Vul je hier een wachtwoord in, dan vraagt de tool daar eenmalig om.
APP_PASSWORD=
