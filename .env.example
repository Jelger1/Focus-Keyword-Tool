# Kopieer dit bestand naar .env.local voor lokaal draaien,
# en zet dezelfde variabelen in Vercel onder Settings -> Environment Variables.

# Verplicht. De analyse van de topresultaten loopt hierlangs.
# Aanmaken op https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optioneel. Laat leeg of weg = de tool is open voor iedereen met de link.
# Vul je hier een wachtwoord in, dan vraagt de tool daar eenmalig om.
APP_PASSWORD=
