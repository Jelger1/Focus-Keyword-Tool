# Kopieer dit bestand naar .env.local voor lokaal draaien,
# en zet dezelfde variabelen in Vercel onder Settings -> Environment Variables.

# Verplicht. De intent check, de herfocus en de content gap lopen via Claude.
# Aanmaken op https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Verplicht. De Google-top 10 met paginatypes, zoekvolumes, keyword-ideeën en
# de zoekwoorden waarop een URL rankt. Aanmaken in Ahrefs onder Account -> API.
AHREFS_API_KEY=

# Optioneel. Google Search Console via een service account. Laat je dit leeg, of
# heeft het account geen toegang tot een domein, dan werkt de tool gewoon op de
# Ahrefs-data (smart fallback).
#
# Aanbevolen: het hele JSON-sleutelbestand in één variabele. In Vercel plak je de
# volledige inhoud van het .json-bestand, van { tot en met }. In .env.local mag het
# ook als base64 op één regel. Staat deze er, dan tellen de twee hieronder niet.
GOOGLE_SERVICE_ACCOUNT_JSON=
#
# Of los: client_email en private_key uit hetzelfde JSON-bestand. De tool herstelt
# gangbare plakfouten zelf (aanhalingstekens, komma's, \n, spaties). In .env.local
# op één regel, zo:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
#
# Controle na elke wijziging (en in Vercel na een redeploy): open
# /api/status?url=<een pagina van de klant>. Geen Ahrefs-units, geen Claude-tokens.

# Optioneel. 'ahrefs' (standaard zodra AHREFS_API_KEY gezet is) of 'serper'.
# Serper geeft de live top 10 zonder paginatypes en topzoekwoorden.
SERP_PROVIDER=

# Alleen nodig als SERP_PROVIDER=serper. Aanmaken op https://serper.dev
SERPER_API_KEY=

# Optioneel. Laat leeg of weg = de tool is open voor iedereen met de link.
# Vul je hier een wachtwoord in, dan vraagt de tool daar eenmalig om.
APP_PASSWORD=
